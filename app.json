{
  "expo": {
    "name": "Al-Ikhlas 86",
    "slug": "al-ikhlas-86",
    "scheme": "alikhlas86",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alikhlas86.mobileapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera dipakai untuk mendaftarkan wajah (presensi otomatis) dan mengambil foto profil.",
        "NSLocationWhenInUseUsageDescription": "Lokasi dipakai untuk memvalidasi bahwa presensi dilakukan di area Yayasan."
      }
    },
    "android": {
      "package": "com.alikhlas86.mobileapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [],
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-navigation-bar",
        { "enforceContrast": false }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera dipakai untuk mendaftarkan wajah (presensi otomatis) dan mengambil foto profil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokasi dipakai untuk memvalidasi bahwa presensi dilakukan di area Yayasan."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#356447"
        }
      ],
      "./plugins/withDebugAppIdSuffix.js",
      "./plugins/withReleaseSigning.js",
      "./plugins/withGradleBuildCache.js",
      "expo-sharing"
    ],
    "extra": {
      "apiUrl": "https://alikhlas86.duckdns.org/mobile-api"
    }
  }
}
